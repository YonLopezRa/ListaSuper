<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ListaSuper" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/surfaceCard</item>
        <item name="android:fontFamily">@font/plus_jakarta_regular</item>
        <item name="android:windowBackground">@color/backgroundGeneral</item>
        <item name="android:textColorPrimary">@color/textDefault</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
    </style>

    <!-- Estilos de Texto Rápidos -->
    <style name="TextTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/plus_jakarta_bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <!-- Estilo para el Toolbar -->
    <style name="ToolbarStyle" parent="Widget.MaterialComponents.Toolbar.Surface">
        <item name="android:background">@color/colorPrimary</item>
        <item name="titleTextColor">@color/textDefault</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="TextPrice" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/plus_jakarta_extra_bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>
</resources>